# Copy to .env and edit.  NEVER commit the real .env file.

# --- Database -------------------------------------------------------------
DATABASE_URL=sqlite:///./data/careerpilot.db
AUTO_SEED_DEMO_JOBS=true

# --- Embeddings -----------------------------------------------------------
# sentence-transformers = real semantic model (first run downloads ~90 MB)
# hashing               = tiny offline fallback for demos/tests (NOT semantic)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- LLM ---------------------------------------------------------------------
# mock | openai | anthropic.   mock needs no key and clearly labels its answers.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
# Optional: OpenAI-compatible endpoint (Groq, Ollama, Azure...). Leave empty for defaults.
LLM_BASE_URL=

# --- RAG / recommendation tuning ----------------------------------------------
RAG_TOP_K=5
RAG_MIN_SCORE=0.2
WEIGHT_SEMANTIC=0.35
WEIGHT_SKILLS=0.40
WEIGHT_LOCATION=0.10
WEIGHT_EXPERIENCE=0.15

# --- Frontend -------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
